{
  "name": "ha-arcus",
  "version": "0.3.1",
  "description": "Arcus — a calm, day-arc dashboard for Home Assistant.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "visual": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "size": "node scripts/check-size.mjs",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:arch": "fallow architecture --boundaries",
    "fallow:audit": "fallow audit --coverage coverage/coverage-final.json",
    "fallow:health": "fallow health --coverage coverage/coverage-final.json --min-score 80",
    "prepare": "panda codegen"
  },
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "dashboard",
    "custom-card"
  ],
  "license": "MIT",
  "devDependencies": {
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@pandacss/preset-panda": "^2.5.0",
    "@pandacss/vite": "^2.5.0",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fallow": "3.43.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
