{
  "name": "ha-arcus",
  "version": "0.1.1",
  "description": "Arcus — a calm, day-arc dashboard for Home Assistant.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "visual": "playwright test"
  },
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "dashboard",
    "custom-card"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "custom-card-helpers": "^2.0.0"
  }
}
